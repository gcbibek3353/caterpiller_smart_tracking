{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "dev:test": "bun scripts/with-test-db.ts bun --watch src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "seed": "bun prisma/seed.ts",
    "seed:fresh": "prisma db push --force-reset --skip-generate && bun prisma/seed.ts",
    "seed:verify": "bun tests/seed.verify.ts",
    "test:api": "bun scripts/with-test-db.ts bun tests/a7.api.check.ts",
    "test:api:seed": "bun scripts/with-test-db.ts bun prisma/seed.ts",
    "db:dump": "bun scripts/db-snapshot.ts dump",
    "db:restore": "bun scripts/db-snapshot.ts restore",
    "sim": "bun simulator/src/index.ts",
    "sim:print-day": "bun simulator/src/print-day.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.5.0",
    "better-auth": "^1.7.2",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^6.5.0",
    "typescript": "^5"
  }
}
