{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "seed": "bun prisma/seed.ts",
    "test:api": "bun tests/a7.api.check.ts",
    "seed:fresh": "prisma db push --force-reset --skip-generate && bun prisma/seed.ts",
    "seed:verify": "bun tests/seed.verify.ts",
    "db:dump": "docker exec rental-postgres pg_dump -U rental -d rental --clean --if-exists > prisma/snapshot.sql",
    "db:restore": "docker exec -i rental-postgres psql -U rental -d rental < prisma/snapshot.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.19.3",
    "@rental/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "croner": "^10.0.1",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
