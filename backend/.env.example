# ── Database ────────────────────────────────────────────────────────────────
# The team shares ONE cloud Postgres (Neon). Ask A for the real strings.
#
# DATABASE_URL is the POOLED endpoint (host contains `-pooler`) — the running
# server uses it. DIRECT_URL is the SAME host without `-pooler`; `prisma db push`
# and `pg_dump` need a session-level connection that pgbouncer cannot give.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ⚠️  DESTRUCTIVE suites (`test:api`, `seed:fresh`) point HERE, never at Neon.
# Start it with `bun run db:up` — local Docker Postgres on host port 5433.
TEST_DATABASE_URL="postgresql://rental:rental@localhost:5433/rental?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="dev-secret-change-me-32-chars-minimum-please"
BETTER_AUTH_URL="http://localhost:4000"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

INGEST_API_KEY="sim-dev-key"

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_MODE="console"          # console | resend
MAIL_FROM="alerts@rental.local"
RESEND_API_KEY=""

TZ="UTC"
